# Model provider (replace locally; never commit the real value)
DASHSCOPE_API_KEY=replace-me

# LangGraph checkpoint store
CHECKPOINT_DATABASE_URL=postgresql://oncall_agent:oncall_dev@127.0.0.1:5433/oncall_agent
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=10
CHECKPOINT_POOL_TIMEOUT=10
CHECKPOINT_AUTO_SETUP=true

# Local PostgreSQL container only
CHECKPOINT_POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:18.4-alpine
CHECKPOINT_POSTGRES_USER=oncall_agent
CHECKPOINT_POSTGRES_PASSWORD=oncall_dev
CHECKPOINT_POSTGRES_DB=oncall_agent
CHECKPOINT_POSTGRES_PORT=5433
